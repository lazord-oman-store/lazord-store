# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# LAZORD Brand Owner Credentials (Configure in Vercel Environment Variables)
LAZORD_ADMIN_USERNAME=
LAZORD_ADMIN_PASSWORD=

# Optional persistent free cloud KV/Redis storage on Vercel (Vercel KV or Upstash Redis)
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
